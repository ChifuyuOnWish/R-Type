# Normalize line endings in the repo, whatever OS people commit from.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.ttf binary
*.otf binary
