{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enemies.schema.json",
  "title": "R-Type enemies and bosses",
  "type": "object",
  "required": [
    "enemies"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enemies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/enemy"
      }
    },
    "bosses": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/boss"
      }
    }
  },
  "$defs": {
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "movement": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "straight",
            "sine",
            "dive",
            "follow",
            "stationary",
            "flight",
            "crawl"
          ],
          "description": "straight: flies left forever. sine: flies left on a sine wave. flight: a sine wave whose centre follows the nearest player (homing). crawl: walks along the floor or ceiling, stops at stopAtX to shoot. dive and stationary are not played yet (they fly straight)."
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "description": "sine and flight: half the height of the bob."
        },
        "frequency": {
          "type": "number",
          "minimum": 0,
          "description": "sine and flight: bobs per second."
        },
        "homing": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "flight only: how fast the bob's centre follows the nearest player up and down, in units per second. 0 never follows."
        },
        "surface": {
          "enum": [
            "floor",
            "ceiling"
          ],
          "description": "crawl only: walks along the bottom or, upside down, along the top of the screen. The wave's y is ignored."
        },
        "stopAtX": {
          "description": "crawl only: the x where it stops to shoot. [min, max] picks one per slug, so a group doesn't pile up on one spot.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "hold": {
          "type": "number",
          "description": "crawl only: seconds it stays and shoots before walking on off the screen. Leave it out to stay until killed (a waitForClear wave then waits for the players to kill it)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "crawl"
              }
            }
          },
          "then": {
            "required": [
              "surface",
              "stopAtX"
            ]
          }
        }
      ]
    },
    "weapon": {
      "type": "object",
      "required": [
        "projectile",
        "cooldown"
      ],
      "additionalProperties": false,
      "properties": {
        "projectile": {
          "type": "string",
          "description": "A name from entity_types.json."
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "aim": {
          "enum": [
            "forward",
            "nearest_player"
          ],
          "default": "forward"
        }
      }
    },
    "drops": {
      "type": "object",
      "description": "Power-up id to drop chance (0 to 1), rolled once on death.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "enemy": {
      "type": "object",
      "required": [
        "type",
        "health",
        "hitbox",
        "speed",
        "movement"
      ],
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "integer",
          "minimum": 1
        },
        "contactDamage": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "hitbox": {
          "$ref": "#/$defs/size"
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "movement": {
          "$ref": "#/$defs/movement"
        },
        "weapon": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/weapon"
            }
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "drops": {
          "$ref": "#/$defs/drops"
        },
        "type": {
          "type": "string",
          "description": "A name from entity_types.json: what clients draw for this entity."
        }
      }
    },
    "boss": {
      "type": "object",
      "required": [
        "type",
        "health",
        "hitbox"
      ],
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "integer",
          "minimum": 1
        },
        "contactDamage": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "hitbox": {
          "$ref": "#/$defs/size"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "enum": [
                "right",
                "top",
                "bottom"
              ]
            },
            "stopAtX": {
              "type": "number"
            },
            "duration": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "weakPoint": {
          "type": "object",
          "description": "Only this area takes full damage, the classic R-Type boss rule.",
          "additionalProperties": false,
          "properties": {
            "offset": {
              "$ref": "#/$defs/size"
            },
            "hitbox": {
              "$ref": "#/$defs/size"
            },
            "damageMultiplier": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "type": {
          "type": "string",
          "description": "A name from entity_types.json: what clients draw for this entity."
        }
      },
      "description": "Tunable numbers only. Attack patterns and phases live in the boss's own class, registered under the same id in BossRegistry."
    }
  }
}
