#!/bin/sh

pattern='^(main|dev|(feat|fix|docs|refactor|test|ci|chore|build|perf|merge)/[a-z0-9._-]+)$'

while read -r local_ref _ _ _; do
    case "$local_ref" in
        refs/heads/*) branch=${local_ref#refs/heads/} ;;
        *) continue ;;
    esac
    if ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
        echo "pre-push: branch name '$branch' does not follow the convention."
        echo "Expected: <type>/<short-description>, e.g. feat/12-udp-socket"
        echo "Rename with: git branch -m <new-name>"
        exit 1
    fi
done
exit 0
