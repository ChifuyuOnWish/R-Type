#!/bin/sh
# Enforces Conventional Commits: <type>(<optional scope>): <description>
# Example: feat(server): add client timeout detection

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Let Git's own merge/revert/fixup messages through.
case "$first_line" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|merge)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
    echo "commit-msg: invalid commit message:"
    echo "    $first_line"
    echo ""
    echo "Expected: <type>(<scope>): <description>   (max 72 chars after the colon)"
    echo "Types:    feat fix docs style refactor perf test build ci chore revert"
    echo "Example:  feat(server): add client timeout detection"
    exit 1
fi
